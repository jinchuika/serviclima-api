# Copie este archivo como .env (en la raíz del proyecto) antes de ejecutar npm run dev.
# .env no se sube a GitHub: está en .gitignore.

# Puerto de la API. 3001 es el que espera el frontend en su VITE_API_URL.
PUERTO=3001

# Origen del frontend que tiene permiso de llamar a la API (CORS).
# En la sesión 6 se cambia por la dirección de GitHub Pages.
ORIGEN_FRONTEND=http://localhost:5173
